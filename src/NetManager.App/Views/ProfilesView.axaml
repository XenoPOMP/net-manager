<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NetManager.App.ViewModels"
             xmlns:s="using:NetManager.Core.Services"
             x:Class="NetManager.App.Views.ProfilesView"
             xmlns:loc="using:NetManager.App.Localization"
             x:DataType="vm:ProfilesViewModel">

  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
    <TextBlock Classes="h1" Text="{loc:T profiles.title}" />

    <Grid Grid.Row="1" ColumnDefinitions="360,20,*">
      <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding Selected}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="s:ConnectionProfile">
            <StackPanel Margin="2,6" Spacing="2">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
              <TextBlock Classes="muted" Text="{Binding AdapterName}" />
              <TextBlock Classes="muted" FontSize="12" Text="{Binding Summary}" TextWrapping="Wrap" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Border Grid.Column="2" Classes="card" VerticalAlignment="Top">
        <StackPanel Spacing="10">
          <StackPanel IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}" Spacing="6">
            <TextBlock Classes="h2" Text="{Binding Selected.Name}" />
            <TextBlock Text="{Binding SelectedAdapterLine}" />
            <TextBlock TextWrapping="Wrap" Text="{Binding Selected.Summary}" />
            <WrapPanel Margin="0,8,0,0">
              <Button Classes="accent" Content="{loc:T profiles.activate}" Command="{Binding ApplyCommand}" Margin="0,0,8,0" />
              <Button Content="{loc:T profiles.delete}" Command="{Binding DeleteCommand}" />
            </WrapPanel>
          </StackPanel>
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNull}}"
                     Text="{loc:T profiles.empty}" />
        </StackPanel>
      </Border>
    </Grid>

    <TextBlock Grid.Row="2" Classes="muted" FontSize="12" Text="{Binding StoreInfo}" />
  </Grid>
</UserControl>
