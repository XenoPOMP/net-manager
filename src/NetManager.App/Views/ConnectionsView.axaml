<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NetManager.App.ViewModels"
             xmlns:m="using:NetManager.Core.Models"
             x:Class="NetManager.App.Views.ConnectionsView"
             x:DataType="vm:ConnectionsViewModel">

  <Grid ColumnDefinitions="300,20,*">

    <!-- adapter list -->
    <DockPanel Grid.Column="0">
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
        <TextBlock Classes="h1" Text="Connections" />
        <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" />
      </Grid>
      <ListBox ItemsSource="{Binding Adapters}" SelectedItem="{Binding Selected}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="m:AdapterInfo">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="2,6" Classes="row" Classes.isoff="{Binding IsDisabled}">
              <Ellipse Classes="dot" Classes.on="{Binding IsConnected}" Classes.off="{Binding IsDisabled}"
                       VerticalAlignment="Top" Margin="0,5,12,0" />
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding RowStatus}" />
                <TextBlock Classes="muted" FontSize="12" Text="{Binding Description}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <!-- Like the Disable/Enable action in Windows' Network Connections window, but one click away on every row. -->
              <ToggleSwitch Grid.Column="2" OnContent="" OffContent="" VerticalAlignment="Center" Margin="8,0,0,0"
                            IsChecked="{Binding IsEnabled, Mode=OneWay}"
                            ToolTip.Tip="Enable / disable this adapter"
                            x:CompileBindings="False"
                            Command="{Binding $parent[ListBox].DataContext.ToggleAdapterCommand}"
                            CommandParameter="{Binding}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <!-- editor -->
    <ScrollViewer Grid.Column="2" IsVisible="{Binding HasSelection}">
      <StackPanel Spacing="14" Margin="0,0,12,0">

        <Border Classes="card" DataContext="{Binding Selected}" x:DataType="m:AdapterInfo">
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Classes="h1" Text="{Binding Name}" />
                <TextBlock Classes="muted" Text="{Binding Description}" />
              </StackPanel>
              <Button Grid.Column="1" VerticalAlignment="Top" x:CompileBindings="False"
                      Content="{Binding $parent[UserControl].DataContext.ToggleEnabledText}"
                      Command="{Binding $parent[UserControl].DataContext.ToggleEnabledCommand}" />
            </Grid>
            <WrapPanel Margin="0,8,0,0">
              <StackPanel Margin="0,0,32,8"><TextBlock Classes="muted" Text="Status" /><TextBlock Text="{Binding StatusText}" /></StackPanel>
              <StackPanel Margin="0,0,32,8"><TextBlock Classes="muted" Text="Type" /><TextBlock Text="{Binding KindText}" /></StackPanel>
              <StackPanel Margin="0,0,32,8"><TextBlock Classes="muted" Text="MAC address" /><TextBlock Text="{Binding MacAddress}" /></StackPanel>
              <StackPanel Margin="0,0,32,8"><TextBlock Classes="muted" Text="Speed" /><TextBlock Text="{Binding SpeedText}" /></StackPanel>
              <StackPanel Margin="0,0,32,8"><TextBlock Classes="muted" Text="MTU" /><TextBlock Text="{Binding Mtu}" /></StackPanel>
              <StackPanel Margin="0,0,32,8" IsVisible="{Binding DhcpServer, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Classes="muted" Text="DHCP server" /><TextBlock Text="{Binding DhcpServer}" />
              </StackPanel>
            </WrapPanel>
          </StackPanel>
        </Border>

        <Border Classes="card" IsVisible="{Binding SelectedIsDisabled}">
          <TextBlock TextWrapping="Wrap"
                     Text="This adapter is disabled. Enable it to view or change its IPv4 and DNS settings." />
        </Border>

        <Border Classes="card" IsVisible="{Binding SelectedIsEnabled}">
          <StackPanel Spacing="4">
            <TextBlock Classes="h2" Text="IPv4" />

            <TextBlock Classes="field" Text="Method" />
            <StackPanel Orientation="Horizontal" Spacing="24">
              <RadioButton GroupName="method" Content="Automatic (DHCP)" IsChecked="{Binding IsAutomatic}" />
              <RadioButton GroupName="method" Content="Manual" IsChecked="{Binding IsManual}" />
            </StackPanel>

            <StackPanel IsVisible="{Binding IsAutomatic}" Margin="0,6,0,0">
              <TextBlock Classes="muted" TextWrapping="Wrap"
                         Text="{Binding Selected.PrimaryAddress, StringFormat='Current lease: {0}'}" />
            </StackPanel>

            <StackPanel IsVisible="{Binding IsManual}">
              <TextBlock Classes="field" Text="Addresses (netmask may be written as 255.255.255.0 or 24)" />
              <ItemsControl ItemsSource="{Binding Addresses}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AddressRow">
                    <Grid ColumnDefinitions="*,8,*,8,Auto" Margin="0,0,0,6">
                      <TextBox Grid.Column="0" Text="{Binding Address}" PlaceholderText="Address, e.g. 192.168.1.10" />
                      <TextBox Grid.Column="2" Text="{Binding Mask}" PlaceholderText="Netmask" />
                      <Button Grid.Column="4" Content="✕" ToolTip.Tip="Remove address"
                              x:CompileBindings="False"
                              Command="{Binding $parent[ItemsControl].DataContext.RemoveAddressCommand}"
                              CommandParameter="{Binding}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Content="＋ Add address" Command="{Binding AddAddressCommand}" />

              <TextBlock Classes="field" Text="Default gateway (leave empty for none)" />
              <TextBox Text="{Binding Gateway}" PlaceholderText="e.g. 192.168.1.1" Width="320" HorizontalAlignment="Left" />
            </StackPanel>

            <TextBlock Classes="h2" Margin="0,18,0,0" Text="DNS" />
            <CheckBox Content="Obtain DNS servers automatically" IsChecked="{Binding DnsAutomatic}" />
            <TextBlock Classes="field" Text="DNS servers (one per line, in order of preference)" />
            <TextBox Text="{Binding DnsText}" AcceptsReturn="True" Height="84" Width="320" HorizontalAlignment="Left"
                     IsEnabled="{Binding !DnsAutomatic}" PlaceholderText="1.1.1.1&#x0a;8.8.8.8" />
          </StackPanel>
        </Border>

        <Border Classes="card" IsVisible="{Binding SelectedIsEnabled}">
          <StackPanel Spacing="12">
            <WrapPanel>
              <Button Classes="accent" Content="Apply" Command="{Binding ApplyCommand}" Margin="0,0,8,8" />
              <Button Content="Revert" Command="{Binding RevertCommand}" Margin="0,0,8,8" />
              <Button Content="Renew DHCP lease" Command="{Binding RenewLeaseCommand}" Margin="0,0,8,8" />
              <Button Content="Flush DNS cache" Command="{Binding FlushDnsCommand}" Margin="0,0,8,8" />
            </WrapPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox Text="{Binding ProfileName}" Width="220" PlaceholderText="Profile name" />
              <Button Content="★ Save as profile" Command="{Binding SaveProfileCommand}" />
            </StackPanel>
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                       Text="A profile stores these settings plus this adapter's static routes, so you can switch networks (home, office, lab) in one click." />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <TextBlock Grid.Column="2" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center"
               IsVisible="{Binding !HasSelection}" Text="No adapter selected" />
  </Grid>
</UserControl>
