<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NetManager.App.ViewModels"
        x:Class="NetManager.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="NetManager" Width="1280" Height="760" MinWidth="900" MinHeight="560"
        Background="{DynamicResource PageBackground}"
        WindowStartupLocation="CenterScreen">

  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!-- Texts that stay on screen across a language change are bound to view-model properties. -->
    <Border Grid.Row="0" Background="#B7791F" Padding="14,8" IsVisible="{Binding ShowAdminWarning}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding AdminBanner}" />
        <Button Grid.Column="1" Margin="12,0,0,0" Content="{Binding AdminButton}" Command="{Binding RestartElevatedCommand}" />
      </Grid>
    </Border>

    <!-- Hardware adapters that used to be here are gone: point the user at the restore page. -->
    <Border Grid.Row="1" Background="#C2410C" Padding="14,8" IsVisible="{Binding ShowMissingBanner}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding MissingBannerText}" />
        <Button Grid.Column="1" Margin="12,0,0,0" Content="{Binding MissingBannerButton}" Command="{Binding OpenMaintenanceCommand}" />
      </Grid>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="232,*">
      <Border Grid.Column="0" Background="{DynamicResource NavBackground}" Padding="8,12">
        <DockPanel>
          <!-- pinned to the bottom, same look as the main entries -->
          <ListBox DockPanel.Dock="Bottom" Margin="0,8,0,0" ItemsSource="{Binding FooterPages}" SelectedItem="{Binding SelectedFooter}" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:NavItem">
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="2,6">
                  <TextBlock Text="{Binding Glyph}" Width="20" TextAlignment="Center" FontSize="16" />
                  <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="150" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <StackPanel Spacing="8">
            <TextBlock Classes="h2" Margin="10,2,0,8" Text="NetManager" />
            <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" Background="Transparent">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:NavItem">
                  <StackPanel Orientation="Horizontal" Spacing="12" Margin="2,6">
                    <TextBlock Text="{Binding Glyph}" Width="20" TextAlignment="Center" FontSize="16" />
                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="150" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </DockPanel>
      </Border>

      <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Margin="20" />
    </Grid>

    <Border Grid.Row="3" Padding="14,6" Background="{DynamicResource NavBackground}"
            DataContext="{Binding Shell}" x:DataType="vm:AppShell">
      <Border.Styles>
        <Style Selector="TextBlock.error"><Setter Property="Foreground" Value="#E5484D" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
      </Border.Styles>
      <Grid ColumnDefinitions="Auto,*,Auto">
        <ProgressBar Grid.Column="0" IsIndeterminate="True" IsVisible="{Binding IsBusy}" Width="80" Margin="0,0,12,0" />
        <TextBlock Grid.Column="1" Text="{Binding Status}" TextTrimming="CharacterEllipsis"
                   Classes.error="{Binding IsError}" />
        <TextBlock Grid.Column="2" Classes="muted" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Backend}" />
      </Grid>
    </Border>
  </Grid>
</Window>
